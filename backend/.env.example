# CatEvents — Environment Variable Reference
# Copy to .env and fill in real values. Never commit real secrets.

# ── Hugging Face ──────────────────────────────────────────────────────────
# Dataset to read/write scraped trends. Overrides config.kdl huggingface block.
HF_TOKEN=                          # Required for uploading to HuggingFace
REPO_ID=                           # e.g. username/dataset-name
HF_REMOTE_FILENAME=trends.json

# ── AI Nitter-query predictor ─────────────────────────────────────────────
AI_API_KEY=                        # Required for AI keyword prediction
AI_API_TYPE=openai                 # "openai" or "anthropic"
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000                          # Overrides config.kdl server.port
SERVER_HOST=0.0.0.0
SERVER_DEBUG=false                 # MUST be false in production
ADMIN_TOKEN=                       # Protects /admin, /run-scrape, /debug/*
                                    # If unset, admin endpoints are UNPROTECTED.

# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET_KEY=                # Flask session signing key. If unset, a
                                    # random ephemeral key is generated per
                                    # process (sessions won't persist across
                                    # restarts). Set in production.

# ── Scheduler ─────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
